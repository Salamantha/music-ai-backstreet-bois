# Hooktheory account (https://www.hooktheory.com) -- used to obtain the API activkey.
HOOKTHEORY_USERNAME=
HOOKTHEORY_PASSWORD=

# Anthropic API key for genre/taste profiling and match rationales.
ANTHROPIC_API_KEY=

# The helper's phrasing layer. Any OpenAI-compatible chat endpoint:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#               LLM_MODEL=llama-3.3-70b-versatile
#   Together    LLM_BASE_URL=https://api.together.xyz/v1
#               LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=qwen/qwen-2.5-72b-instruct
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1
#               LLM_MODEL=qwen2.5:7b   (LLM_API_KEY can stay empty)
# Without these the helper still answers, from a template, and says so.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional overrides
CHORDCAT_DB_PATH=./var/chordcat.db
CHORDCAT_LOG_LEVEL=INFO
# Set to 1 to forbid any live network call (tests / offline dev).
CHORDCAT_OFFLINE=0
