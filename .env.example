# Hooktheory account (https://www.hooktheory.com) -- used to obtain the API activkey.
HOOKTHEORY_USERNAME=
HOOKTHEORY_PASSWORD=

# Anthropic API key for genre/taste profiling and match rationales.
ANTHROPIC_API_KEY=

# Supabase project holding the room of real musicians. The shared project is
# hardcoded in api/src/chordcat/config.py; only set these to point at a
# different project. RLS is off on the `users` table, so the publishable key
# is enough; swap in a service key if RLS is ever enabled.
# SUPABASE_URL=
# SUPABASE_KEY=

# Optional overrides
CHORDCAT_DB_PATH=./var/chordcat.db
CHORDCAT_LOG_LEVEL=INFO
# Set to 1 to forbid any live network call (tests / offline dev).
CHORDCAT_OFFLINE=0
