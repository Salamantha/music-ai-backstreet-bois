{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["chordcat.main:app", "--reload", "--app-dir", "src"],
      "cwd": "${workspaceFolder}/api",
      "python": "${workspaceFolder}/api/.venv/bin/python",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
